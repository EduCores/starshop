# StarShop - Variables de entorno
# Copia este archivo a .env.local y completa con tus credenciales reales
# Para PaaS (Vercel, Railway, Render) configura estas mismas vars en el panel del servicio

# URL pública de tu app (usada para construir returnUrl de Webpay y back_urls de MercadoPago)
# En local: http://localhost:3000
# En PaaS: https://tu-dominio.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Transbank Webpay Plus ──
# Por defecto usa credenciales de INTEGRACIÓN (pruebas) si no defines estas vars
# Para producción pide tus credenciales en https://www.transbankdevelopers.cl/
# WEBPAY_COMMERCE_CODE=597055555532
# WEBPAY_API_KEY=579B532A7440BB0C9079DED94D31EA1615BACEB56610332264630D42D0A36B1C
# WEBPAY_ENV=integration  # usa "production" cuando tengas credenciales reales

# ── MercadoPago ──
# Obtén tu Access Token en https://www.mercadopago.com/developers/panel/app
# Usa el token de PRUEBA para testear (TEST-xxx) y el de PRODUCCIÓN para cobrar real
# MERCADOPAGO_ACCESS_TOKEN=TEST-1234567890abcdef1234567890abcdef-123456
# Para PaaS no olvides configurar también MERCADOPAGO_ACCESS_TOKEN en el dashboard

# ── Notas ──
# - Webpay integración acepta cualquier tarjeta de prueba (ej. 4051885600446623, CVV 123, cualquier fecha futura)
# - MercadoPago en sandbox usa tarjetas de prueba de su docs
# - El webhook de MercadoPago (/api/mercadopago/webhook) debe ser público; en local usa ngrok para probarlo
#   Con MERCADOPAGO_ACCESS_TOKEN configurado, el webhook valida el pago real antes de aprobar la orden.
# - data/orders.json y data/users.json NO persisten en serverless (Vercel): usa PostgreSQL en produccion
# - NextAuth requiere NEXTAUTH_SECRET en produccion

# Agente LLM (modo real; sin key corre en modo Mock RAG sin gastar tokens)
OPENROUTER_API_KEY=sk-or-v1-tu-key-aqui
# OPENROUTER_MODEL=google/gemini-2.0-flash-001
# OPENROUTER_EMBED_MODEL=openai/text-embedding-3-small
# Widget del chat: ruta local del agente (en produccion apuntar al deployment ACS)
NEXT_PUBLIC_ACS_API_URL=http://localhost:3000

# ── Datos multi-tenant (ver docs/ARQUITECTURA-DATOS.md) ──
# DATA_PROVIDER=local        # default: mock-data + data/*.json (demo sin infra)
# DATA_PROVIDER=supabase     # requiere las 3 vars siguientes
# SUPABASE_URL=https://xyzcompany.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi... (SOLO servidor, nunca NEXT_PUBLIC_)
# STARSHOP_TENANT_ID=seed-store   # slug o uuid del tenant que sirve este deploy
# Identidad que el widget manda al cerebro (ACS) como `storeId`
# NEXT_PUBLIC_STARSHOP_TENANT_ID=seed-store
